{
  "name": "griffincss-utils",
  "version": "0.21.0",
  "description": "Griffincss Utils — утилитарные классы: отступы, типографика, цвета, видимость, скругления",
  "homepage": "https://gitverse.ru/BarneyScott/GriffinCSS",
  "repository": {
    "type": "git",
    "url": "git+https://gitverse.ru/BarneyScott/GriffinCSS.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://gitverse.ru/BarneyScott/GriffinCSS/issues"
  },
  "author": "Лазарев Михаил Юрьевич <bersi82@gmail.com>",
  "license": "MIT",
  "main": "dist/griffincss-utils.css",
  "style": "dist/griffincss-utils.css",
  "sass": "scss/griffincss-utils.scss",
  "exports": {
    ".": "./dist/griffincss-utils.css",
    "./js": "./dist/griffincss-utils.js",
    "./scoped": "./dist/griffincss-utils-scoped.css",
    "./scss": "./scss/griffincss-utils.scss",
    "./scss/*": "./scss/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scss/",
    "src/"
  ],
  "peerDependencies": {
    "griffincss-core": "^0.21.0"
  },
  "keywords": [
    "css",
    "scss",
    "sass",
    "utilities",
    "spacing",
    "typography",
    "griffincss"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:scoped && npm run build:js",
    "build:css": "sass scss/griffincss-utils.scss dist/griffincss-utils.css --load-path=../../node_modules --style=compressed --no-source-map",
    "build:scoped": "sass scss/griffincss-utils-scoped.scss dist/griffincss-utils-scoped.css --load-path=../../node_modules --style=compressed --no-source-map",
    "build:js": "terser src/griffincss-utils.js -c passes=3,ecma=2020,unsafe_arrows=true -m --ecma 2020 --comments false --format \"preamble='/*! Griffincss Utils | MIT | https://gitverse.ru/BarneyScott/GriffinCSS */'\" --source-map \"url='griffincss-utils.js.map'\" -o dist/griffincss-utils.js"
  }
}
