{
  "name": "griffincss-ui",
  "version": "0.26.0",
  "description": "Griffincss UI — компоненты интерфейса: кнопки, поля, карточки, таблицы, статусы; на токенах ядра, с обеими темами и режимом для слабовидящих. Плюс GriffinJS — опциональный слой виджетов: слайдер, галерея, лайтбокс, параллакс, мегаменю, дропдаун, подсказка, окна, комбобокс",
  "homepage": "https://gitverse.ru/BarneyScott/GriffinCSS",
  "repository": {
    "type": "git",
    "url": "git+https://gitverse.ru/BarneyScott/GriffinCSS.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://gitverse.ru/BarneyScott/GriffinCSS/issues"
  },
  "author": "Лазарев Михаил Юрьевич <bersi82@gmail.com>",
  "license": "MIT",
  "main": "dist/griffincss-ui.css",
  "style": "dist/griffincss-ui.css",
  "sass": "scss/griffincss-ui.scss",
  "exports": {
    ".": "./dist/griffincss-ui.css",
    "./scoped": "./dist/griffincss-ui-scoped.css",
    "./js": "./dist/griffincss-ui.js",
    "./griffinjs": "./dist/griffinjs.js",
    "./griffinjs.css": "./dist/griffinjs.css",
    "./griffinjs-fields": "./dist/griffinjs-fields.js",
    "./griffinjs-fields.css": "./dist/griffinjs-fields.css",
    "./griffinjs-countries": "./dist/griffinjs-countries.js",
    "./scss": "./scss/griffincss-ui.scss",
    "./scss/*": "./scss/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scss/",
    "src/"
  ],
  "peerDependencies": {
    "griffincss-core": "^0.26.0"
  },
  "keywords": [
    "css",
    "scss",
    "sass",
    "ui",
    "components",
    "button",
    "form",
    "card",
    "slider",
    "gallery",
    "lightbox",
    "megamenu",
    "combobox",
    "griffinjs",
    "griffincss"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:scoped && npm run build:js && npm run build:griffinjs",
    "build:css": "sass scss/griffincss-ui.scss dist/griffincss-ui.css --load-path=../../node_modules --style=compressed --no-source-map",
    "build:scoped": "sass scss/griffincss-ui-scoped.scss dist/griffincss-ui-scoped.css --load-path=../../node_modules --style=compressed --no-source-map",
    "build:js": "node ../../scripts/build-js.mjs",
    "build:griffinjs": "node ../../scripts/build-griffinjs.mjs",
    "prepublishOnly": "node -e \"const v=require('./package.json').version;if(/-dev$/.test(v)){console.error('Griffincss: версия '+v+' с суффиксом -dev — публикуют из публичного дерева (npm run release:public), а не из Dev');process.exit(1)}\""
  }
}
